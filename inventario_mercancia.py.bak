    return os.path.join(get_appdata_folder(), "preferencias.json")


def cargar_preferencias():
    try:
        with open(get_prefs_path(), "r", encoding="utf-8") as f:
            d = json.load(f)
            return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def guardar_preferencia(clave, valor):
