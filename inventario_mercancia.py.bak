def cargar_catalogo_completo():
    cat = CATALOGO_BASE.copy()
    path = get_catalogo_path()
    if os.path.exists(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                custom = json.load(f)
                cat.update(custom)
        except Exception:
            pass
    return cat

def guardar_insumo_personalizado(nombre, codigo):
    path = get_catalogo_path()
    custom = {}
    if os.path.exists(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                custom = json.load(f)
        except Exception:
            pass
    
    nombre_clean = str(nombre).strip().upper()
    codigo_clean = str(codigo).strip().upper()
    custom[nombre_clean] = codigo_clean

    escribir_json_seguro(path, custom)

def cargar_historial_tandas():
    path = get_historial_path()
    if os.path.exists(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            try:   # archivo dañado: se conserva una copia para recuperarlo a mano
                shutil.copy2(path, path + f".corrupto_{datetime.datetime.now():%Y%m%d_%H%M%S}")
            except Exception:
                pass
            return []
    return []

def guardar_tanda_en_historial(tanda_dict):
    historial = cargar_historial_tandas()
    historial.insert(0, tanda_dict) # El más reciente primero
    escribir_json_seguro(get_historial_path(), historial)

def renombrar_tanda_en_historial(id_viejo, id_nuevo):
    """Cambia el ID de una tanda. Devuelve False si el nombre nuevo ya existe o no se halló la tanda."""
    historial = cargar_historial_tandas()
    if any(t.get("id") == id_nuevo for t in historial if t.get("id") != id_viejo):
        return False
    for t in historial:
        if t.get("id") == id_viejo:
            t["id"] = id_nuevo
            escribir_json_seguro(get_historial_path(), historial)
            return True
    return False

def eliminar_tanda_del_historial(id_tanda):
    """Borra una tanda del historial. Devuelve True si la encontró y la eliminó."""
    historial = cargar_historial_tandas()
    for i, t in enumerate(historial):
        if t.get("id") == id_tanda:
            del historial[i]
            escribir_json_seguro(get_historial_path(), historial)
            return True
    return False


def leer_portapapeles_win():
    """Lee el texto del portapapeles de Windows directamente (sin depender de Tk). Devuelve '' si no hay."""
    if os.name != "nt":
        return ""
    try:
        import ctypes
        from ctypes import wintypes
        u32, k32 = ctypes.windll.user32, ctypes.windll.kernel32
        u32.GetClipboardData.restype = wintypes.HANDLE
        k32.GlobalLock.restype = ctypes.c_void_p
        k32.GlobalLock.argtypes = [wintypes.HANDLE]
        k32.GlobalUnlock.argtypes = [wintypes.HANDLE]
        for _ in range(20):
            if u32.OpenClipboard(None):
                break
            time.sleep(0.05)
        else:
            return ""
        texto = ""
        try:
            h = u32.GetClipboardData(13)   # CF_UNICODETEXT
            if h:
                p = k32.GlobalLock(h)
                if p:
                    texto = ctypes.wstring_at(p)
                    k32.GlobalUnlock(h)
        finally:
            u32.CloseClipboard()
        return texto
    except Exception:
        return ""


def vaciar_portapapeles_win():
    """Vacía el portapapeles de Windows (para saber si una copia realmente ocurrió)."""
    if os.name != "nt":
        return
    try:
        import ctypes
        u32 = ctypes.windll.user32
        for _ in range(20):
            if u32.OpenClipboard(None):
                break
            time.sleep(0.05)
        else:
            return
        try:
            u32.EmptyClipboard()
        finally:
            u32.CloseClipboard()
    except Exception:
        pass


def pegar_en_entry(entry):
    """Pega el portapapeles en un Entry (una sola línea). Usa Tk y, si falla, el portapapeles de Windows."""
    try:
        txt = entry.clipboard_get()
    except tk.TclError:
        txt = ""
    if not txt:
        txt = leer_portapapeles_win()
    txt = " ".join(str(txt).split())   # quita saltos de línea y espacios sobrantes
    if not txt:
        return
    try:
        entry.delete("sel.first", "sel.last")
    except tk.TclError:
        pass
    entry.insert("insert", txt)


def habilitar_atajos_portapapeles(entry):
    """Ctrl+C / Ctrl+V / Ctrl+X / Ctrl+A y clic derecho (Cortar/Copiar/Pegar) en un Entry,
    sin depender del idioma del teclado ni del Bloq Mayús."""
    def copiar(cortar=False):
        try:
            sel = entry.selection_get()
        except tk.TclError:
            return
        entry.clipboard_clear()
        entry.clipboard_append(sel)
        if cortar:
            try:
                entry.delete("sel.first", "sel.last")
            except tk.TclError:
                pass

    def seleccionar_todo():
        entry.selection_range(0, tk.END)
        entry.icursor(tk.END)

    def on_key(e):
        k = e.keycode            # código de tecla de Windows: V=86, C=67, X=88, A=65
        if k == 86:
            pegar_en_entry(entry)
        elif k == 67:
            copiar()
        elif k == 88:
            copiar(True)
        elif k == 65:
            seleccionar_todo()
        else:
            return None
        return "break"

    entry.bind("<Control-KeyPress>", on_key)

    menu = tk.Menu(entry, tearoff=0)
    menu.add_command(label="Cortar", command=lambda: copiar(True))
    menu.add_command(label="Copiar", command=copiar)
    menu.add_command(label="Pegar", command=lambda: pegar_en_entry(entry))
    menu.add_separator()
    menu.add_command(label="Seleccionar todo", command=seleccionar_todo)

    def popup(e):
        entry.focus_set()
        try:
            menu.tk_popup(e.x_root, e.y_root)
        finally:
            menu.grab_release()

    entry.bind("<Button-3>", popup)
    return entry


def obtener_codigo(nombre_producto, catalogo):
    nombre_limpio = str(nombre_producto).strip().upper()
    nombre_normalizado = (nombre_limpio
                          .replace("COLI FLOR", "COLIFLOR")
                          .replace("COLIFLOS", "COLIFLOR")
                          .replace("SOVITO", "JOVITO")
                          .replace("PERESIL", "PEREJIL")
                          .replace("ZANAHOSIA", "ZANAHORIA")
                          .replace("ZANA HORIA", "ZANAHORIA")
                          .replace("ESPINACU", "ESPINACA")
                          .replace("GENJIBRE", "JENGIBRE")
                          .replace("SILANDRO", "CILANTRO")
                          .replace("CILATRNO", "CILANTRO")
                          .replace("AJI JOBITO", "AJI JOVITO"))
    
    codigo_hallado = None
    if nombre_limpio.isdigit():
        codigo_hallado = nombre_limpio
    elif nombre_limpio in catalogo:
        codigo_hallado = catalogo[nombre_limpio]
    elif (c := buscar_exacto_norm(nombre_limpio, catalogo)) is not None:
        codigo_hallado = c            # coincidencia exacta ignorando tildes (PINA = PIÑA)
    elif nombre_normalizado in catalogo:
        codigo_hallado = catalogo[nombre_normalizado]
    else:
        mejor, mejor_r = None, 0.0
        for key, code in catalogo.items():
            if len(key) >= 3 and (key in nombre_limpio or nombre_limpio in key):
                r = difflib.SequenceMatcher(None, key, nombre_limpio).ratio()
                if r > mejor_r and r >= 0.55:
                    mejor, mejor_r = code, r
        if mejor:
            codigo_hallado = mejor
                
    if not codigo_hallado:
        codigo_hallado = nombre_limpio
        
    if len(codigo_hallado) == 3 and codigo_hallado.isdigit():
        codigo_hallado = f"0{codigo_hallado}"
        
    return codigo_hallado

def parse_cantidad(val):
    val_str = str(val).lower().replace(',', '.')
    val_limpia = re.sub(r'[^0-9.+]|\.(?=\.)', '', val_str)
    
    if not val_limpia:
        return 0.0

    parts = []
    for p in val_limpia.split('+'):
        p = p.strip()
        if p:
            try:
                parts.append(float(p))
            except ValueError:
                continue

    converted = []
    for p in parts:
        if p >= 10:
            p = p / 1000.0
        converted.append(p)
    return sum(converted)


def evaluar_linea_manual(linea, catalogo):
    """Analiza una línea de la carga manual. nivel: 'ok' | 'warn' | 'err'."""
    r = {"producto": "", "cantidad": "", "codigo": "", "kg": 0.0,
         "nivel": "ok", "msg": "", "sugerencias": []}
    linea = linea.strip()
    m = RE_CANT_FINAL.search(linea)
    if not m:
        r.update(producto=linea.upper(), nivel="err", msg="Falta la cantidad (o está mal escrita)")
        return r

    r["producto"] = linea[:m.start()].strip().upper()
    r["cantidad"] = m.group(1).strip()
    unidad = m.group(2)

    if not r["producto"]:
        r.update(nivel="err", msg="Falta el nombre del producto")
        return r

    # --- cantidad ---
    nums = []
    for p in r["cantidad"].split("+"):
        try:
            nums.append(float(p.strip().replace(",", ".")))
        except ValueError:
            r.update(nivel="err", msg=f"Número mal escrito: «{p.strip()}»")
            return r
    r["kg"] = parse_cantidad(r["cantidad"])
    if r["kg"] <= 0:
        r.update(nivel="err", msg="La cantidad es 0")
        return r

    # --- producto ---
    limpio = r["producto"]
    cod = obtener_codigo(limpio, catalogo)
    r["codigo"] = cod
    if not limpio.isdigit() and limpio not in catalogo and buscar_exacto_norm(limpio, catalogo) is None:
        if cod == limpio:   # no se encontró nada
            r["sugerencias"] = difflib.get_close_matches(limpio, list(catalogo.keys()), n=3, cutoff=0.6)
            sug = f" ¿Quisiste decir: {', '.join(r['sugerencias'])}? (doble clic)" if r["sugerencias"] else ""
            r.update(nivel="err", msg="No está en el catálogo." + sug)
            return r
        r["nivel"], r["msg"] = "warn", f"Coincidencia aproximada → código {cod}. Verifica"

    # --- advertencias de cantidad ---
    avisos = []
    if any(10 <= n < 100 for n in nums):
        avisos.append("Un valor entre 10 y 99 se toma como GRAMOS")
    if r["kg"] > LIMITE_KG_ALERTA:
        avisos.append(f"Cantidad muy alta ({r['kg']:.1f} kg)")
    if unidad:
        avisos.append(f"Se ignora la unidad «{unidad}»")
    if avisos:
        r["nivel"] = "warn"
        r["msg"] = (r["msg"] + " · " if r["msg"] else "") + " · ".join(avisos)
    return r


HTML_MOBILE = """
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Frulever - Envío de Inventario</title>
    <style>
        body { font-family: sans-serif; background: #f0f4f8; text-align: center; padding: 20px; color: #333; }
        .card { background: white; border-radius: 12px; padding: 25px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); max-width: 400px; margin: auto; }
        h2 { color: #1F4E79; margin-top: 0; }
        input[type="file"] { display: none; }
        .btn-upload { background: #17A2B8; color: white; padding: 15px 25px; border-radius: 8px; font-size: 16px; font-weight: bold; display: inline-block; cursor: pointer; margin-top: 15px; }
        .btn-submit { background: #28A745; color: white; border: none; padding: 15px; border-radius: 8px; font-size: 16px; font-weight: bold; width: 100%; margin-top: 20px; cursor: pointer; display: none; }
        #status { margin-top: 15px; font-weight: bold; color: #0D6EFD; }
    </style>
</head>
<body>
    <div class="card">
        <h2>Frulever 🍎</h2>
        <p>Toma una o varias fotos, o elígelas de tu galería.</p>
        <form id="uploadForm" enctype="multipart/form-data">
            <label class="btn-upload">
                📷 Tomar Foto / Galería
                <input type="file" name="photo" id="photoInput" accept="image/*" multiple onchange="onFileSelected()">
            </label>
            <div id="fileCount" style="margin-top: 10px; font-weight: bold;"></div>
            <button type="button" id="submitBtn" class="btn-submit" onclick="uploadPhotos()">🚀 Enviar a la PC</button>
        </form>
        <div id="status"></div>
    </div>
    <script>
        const MAX_DIM = 2200;
        function onFileSelected() {
            const input = document.getElementById('photoInput');
            const btn = document.getElementById('submitBtn');
            const count = document.getElementById('fileCount');
            if (input.files.length > 0) {
                if (input.files.length === 1) {
                    count.innerText = "Foto seleccionada: " + input.files[0].name;
                    btn.innerText = "🚀 Enviar a la PC";
                } else {
                    count.innerText = input.files.length + " fotos seleccionadas";
                    btn.innerText = "🚀 Enviar " + input.files.length + " fotos a la PC";
                }
                btn.style.display = "block";
            }
        }
        async function reducir(file) {
            try {
                const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' });
                const r = Math.min(1, MAX_DIM / Math.max(bmp.width, bmp.height));
                const w = Math.round(bmp.width * r);
                const h = Math.round(bmp.height * r);
                const cv = document.createElement('canvas');
                cv.width = w;
                cv.height = h;
                cv.getContext('2d').drawImage(bmp, 0, 0, w, h);
                const blob = await new Promise(res => cv.toBlob(res, 'image/jpeg', 0.88));
                if (blob && blob.size < file.size) return blob;
            } catch (e) {
                console.log(e);
            }
            return file;
        }
        async function uploadPhotos() {
            const input = document.getElementById('photoInput');
            const status = document.getElementById('status');
            const btn = document.getElementById('submitBtn');
            const total = input.files.length;
            if (total === 0) return;
            btn.disabled = true;
            let ok = 0;
            let fallos = 0;
            for (let i = 0; i < total; i++) {
                status.style.color = "#0D6EFD";
                status.innerText = "⏳ Enviando foto " + (i + 1) + " de " + total + "...";
                try {
                    const blob = await reducir(input.files[i]);
                    const formData = new FormData();
                    formData.append('photo', blob, 'foto_' + (i + 1) + '.jpg');
                    const response = await fetch('/upload', { method: 'POST', body: formData });
                    const res = await response.json();
                    if (res.status === 'ok') { ok++; } else { fallos++; }
                } catch (e) {
                    fallos++;
                }
            }
            if (fallos === 0) {
                status.innerHTML = "✅ ¡" + ok + (ok === 1 ? " foto enviada" : " fotos enviadas") + " con éxito!<br>La PC las está procesando. Puedes tomar más si deseas sumar.";
                status.style.color = "#28A745";
            } else {
                status.innerText = "⚠️ Enviadas: " + ok + " · con error: " + fallos + ". Revisa la conexión con la PC.";
                status.style.color = "#DC3545";
            }
            input.value = '';
            document.getElementById('fileCount').innerText = '';
            btn.style.display = "none";
            btn.disabled = false;
        }
    </script>
</body>
</html>
"""


# =====================================================================
#  ESTILO VISUAL (tarjetas redondeadas, botones tipo píldora, etc.)
# =====================================================================
UI_BG = "#E7ECF0"       # fondo general de la ventana
UI_CARD = "#F3F6F8"     # fondo de las tarjetas
UI_NAVY = "#113A57"     # cabecera
UI_ORANGE = "#F4592D"   # botón Añadir Insumo
UI_GREEN = "#2E9A52"    # barra de estado
UI_TEXT = "#1E2A36"
UI_MUTED = "#6B7783"
UI_SEL = "#E3E6EA"      # fila seleccionada
UI_LINE = "#DDE1E5"
FONT = "Segoe UI"

RAZONES = ("TRANSFERENCIA", "MERMA")
RAZON_PLACEHOLDER = "Seleccionar…"
RAZON_COLORES = {"TRANSFERENCIA": ("#E3F0FF", "#1F5FA8"), "MERMA": ("#FDEBD9", "#B25400")}


def _mezclar(c1, c2, t):
    """Mezcla dos colores #RRGGBB (t=0 -> c1, t=1 -> c2). Sirve para animar el hover."""
    a = [int(c1[i:i + 2], 16) for i in (1, 3, 5)]
    b = [int(c2[i:i + 2], 16) for i in (1, 3, 5)]
    return "#%02X%02X%02X" % tuple(round(x + (y - x) * t) for x, y in zip(a, b))

EMOJI_RE = re.compile(r'^\s*([\U0001F300-\U0001FAFF\u2600-\u27BF])\ufe0f?\s*(.*)$', re.S)
EMOJI_STRIP_RE = re.compile(r'[\U0001F300-\U0001FAFF\u2600-\u27BF\ufe0f]')


@functools.lru_cache(maxsize=512)
def make_round_image(w, h, r, fill, bg, border=None, pad=0, shadow=0.0):
    """Rectángulo redondeado con bordes suaves (supermuestreo) y sombra opcional."""
    S = 3
    W, H = max(int(w), 4), max(int(h), 4)
    base = Image.new("RGB", (W, H), bg)
    box = [pad * S, pad * S, (W - pad) * S - 1, (H - pad) * S - 1]

    if shadow:
        sh = Image.new("L", (W * S, H * S), 0)
        ImageDraw.Draw(sh).rounded_rectangle(
            [box[0], box[1] + 2 * S, box[2], box[3] + 2 * S], radius=r * S, fill=int(255 * shadow))
        sh = sh.resize((W, H), Image.LANCZOS).filter(ImageFilter.GaussianBlur(max(2, pad // 2)))
        base.paste("#3A4A5A", (0, 0, W, H), sh)

    outer = Image.new("L", (W * S, H * S), 0)
    ImageDraw.Draw(outer).rounded_rectangle(box, radius=r * S, fill=255)
    outer = outer.resize((W, H), Image.LANCZOS)

    if border:
        base.paste(border, (0, 0, W, H), outer)
        inner = Image.new("L", (W * S, H * S), 0)
        ImageDraw.Draw(inner).rounded_rectangle(
            [box[0] + S, box[1] + S, box[2] - S, box[3] - S], radius=max(r - 1, 1) * S, fill=255)
        base.paste(fill, (0, 0, W, H), inner.resize((W, H), Image.LANCZOS))
    else:
        base.paste(fill, (0, 0, W, H), outer)
    return base


_emoji_cache = {}


def emoji_photo(ch, px):
    """Emoji a color como imagen (Segoe UI Emoji en Windows). Devuelve None si no se puede."""
    key = (ch, px)
    if key in _emoji_cache:
        return _emoji_cache[key]
    photo = None
    try:
        from PIL import ImageFont
        font = ImageFont.truetype("seguiemj.ttf", 109)
        lienzo = Image.new("RGBA", (160, 160), (0, 0, 0, 0))
        ImageDraw.Draw(lienzo).text((80, 80), ch.replace("\ufe0f", ""), font=font,
                                    embedded_color=True, anchor="mm")
        if lienzo.getbbox():
            im = lienzo.crop((14, 14, 146, 146)).resize((px, px), Image.LANCZOS)
            photo = ImageTk.PhotoImage(im)
    except Exception:
        photo = None
    _emoji_cache[key] = photo
    return photo


def formatear_fecha_corta(texto):
    try:
        dt = datetime.datetime.strptime(texto, "%d/%m/%Y %I:%M:%S %p")
        return dt.strftime("%d/%m/%Y %I:%M %p")
    except Exception:
        return str(texto)


class ProcessingBanner(tk.Canvas):
    """Franja con spinner animado que indica que una foto se está procesando."""
    ALTO = 48

    def __init__(self, parent):
        super().__init__(parent, height=self.ALTO, bg=parent.cget("bg"), highlightthickness=0, bd=0)
        self._titulo, self._detalle = "Procesando foto…", ""
        self._angle, self._running = 0, False
        self.bind("<Configure>", lambda e: self._render())

    def set_text(self, titulo, detalle=""):
        self._titulo, self._detalle = titulo, detalle
        self._render()

    def start(self):
        if not self._running:
            self._running = True
            self._tick()

    def stop(self):
        self._running = False

    def _tick(self):
        if not self._running:
            return
        self._angle = (self._angle - 16) % 360
        self.itemconfigure("spin", start=self._angle)
        self.after(35, self._tick)

    def _render(self):
        w, h = self.winfo_width(), self.ALTO
        if w < 40:
            return
        self.delete("all")
        self._img = ImageTk.PhotoImage(make_round_image(
            w, h, (h - 6) // 2, "#E6F0FB", self.master.cget("bg"), "#9CC3EC", 3, 0))
        self.create_image(0, 0, anchor="nw", image=self._img)
        cy = h / 2
        self.create_oval(18, cy - 10, 38, cy + 10, outline="#BBD3EE", width=3)
        self.create_arc(18, cy - 10, 38, cy + 10, start=self._angle, extent=100, style="arc",
                        outline="#2F6FB5", width=3, tags="spin")
        if self._detalle:
            self.create_text(52, cy - 8, anchor="w", text=self._titulo, fill="#1F4E79", font=(FONT, 10, "bold"))
            self.create_text(52, cy + 9, anchor="w", text=self._detalle, fill="#4A6580", font=(FONT, 9))
        else:
            self.create_text(52, cy, anchor="w", text=self._titulo, fill="#1F4E79", font=(FONT, 10, "bold"))


class Card(tk.Canvas):
    """Tarjeta blanca con esquinas redondeadas y sombra suave. El contenido va en `.inner`."""
    def __init__(self, parent, page_bg=UI_BG, fill=UI_CARD, radius=16, pad=8, inset=(12, 12)):
        super().__init__(parent, width=1, height=1, bg=page_bg, highlightthickness=0, bd=0)
        self._page_bg, self._fill, self._r, self._pad, self._inset = page_bg, fill, radius, pad, inset
        self._bg_item = self.create_image(0, 0, anchor="nw")
        self.inner = tk.Frame(self, bg=fill)
        self._win = self.create_window(pad + inset[0], pad + inset[1], window=self.inner, anchor="nw")
        self.bind("<Configure>", self._redraw)

    def _redraw(self, e):
        if e.width < 30 or e.height < 30:
            return
        img = make_round_image(e.width, e.height, self._r, self._fill, self._page_bg, None, self._pad, 0.16)
        self._photo = ImageTk.PhotoImage(img)
        self.itemconfigure(self._bg_item, image=self._photo)
        dx, dy = self._pad + self._inset[0], self._pad + self._inset[1]
        self.itemconfigure(self._win, width=max(10, e.width - 2 * dx), height=max(10, e.height - 2 * dy))


class PillButton(tk.Canvas):
    """Botón redondeado con icono + texto. Compatible con .config(text=, state=, command=, bg=)."""
    def __init__(self, parent, text="", command=None, height=44, fill="#FFFFFF", border="#C9CED3",
                 fg=UI_TEXT, hover="#EEF2F5", font=(FONT, 10, "bold"), icon=None, shadow=0.0,
                 state="normal", padx=22):
        super().__init__(parent, width=10, height=height, bg=parent.cget("bg"),
                         highlightthickness=0, bd=0, cursor="hand2")
        self._command, self._h = command, height
        self._fill, self._border, self._fg, self._hover_fill = fill, border, fg, hover
        self._shadow, self._state, self._padx = shadow, state, padx
        self._danger = False
        self._over = False
        self._down = False
        self._t, self._target, self._anim_job = 0.0, 0.0, None
        self._font = tkfont.Font(family=font[0], size=font[1], weight=font[2] if len(font) > 2 else "normal")
        self._text, self._icon = "", None
        self._set_text(text, icon)
        self._fit_width()
        self.bind("<Configure>", lambda e: self._render())
        self.bind("<Enter>", lambda e: self._set_over(True))
        self.bind("<Leave>", lambda e: self._set_over(False))
        self.bind("<ButtonPress-1>", self._on_press)
        self.bind("<ButtonRelease-1>", self._on_release)

    # ---- contenido ----
    def _set_text(self, text, icon=None):
        text = text or ""
        if icon is None:
            m = EMOJI_RE.match(text)
            if m:
                icon, text = m.group(1), m.group(2)
            elif text.startswith("+ "):
                icon, text = "plus", text[2:]
        self._text, self._icon = text, icon

    def _icon_size(self):
        return int(self._h * 0.42)

    def _icon_width(self):
        if not self._icon:
            return 0
        if self._icon == "plus":
            return int(self._icon_size() * 0.8)
        if emoji_photo(self._icon, self._icon_size()):
            return self._icon_size()
        return self._font.measure(self._icon) + 2

    def _fit_width(self):
        gap = 9 if (self._icon and self._text) else 0
        w = 2 * self._padx + self._icon_width() + gap + self._font.measure(self._text) + 8
        tk.Canvas.configure(self, width=w)

    # ---- dibujo ----
    def refresh(self):
        self._render()

    def _render(self):
        w, h = self.winfo_width(), self._h
        if w < 12:
            return
        self.delete("all")
        bg = self.master.cget("bg")
        disabled = self._state == "disabled"
        fill = self._fill if disabled else _mezclar(self._fill, self._hover_fill, self._t)
        border = "#E3E7EA" if disabled else self._border
        self._bg_photo = ImageTk.PhotoImage(make_round_image(
            w, h, (h - 8) // 2, fill, bg, border, 4, 0 if disabled else self._shadow))
        self.create_image(0, 0, anchor="nw", image=self._bg_photo)

        color = "#9AA5AF" if disabled else ("#C62828" if self._danger else self._fg)
        isz, iw = self._icon_size(), self._icon_width()
        gap = 9 if (self._icon and self._text) else 0
        total = iw + gap + self._font.measure(self._text)
        x = (w - total) / 2
        cy = h / 2 + (1 if self._down else 0)

        if self._icon == "plus":
            c = x + iw / 2
            a = iw / 2.2
            self.create_line(c - a, cy, c + a, cy, fill=color, width=2.5, capstyle="round")
            self.create_line(c, cy - a, c, cy + a, fill=color, width=2.5, capstyle="round")
        elif self._icon:
            foto = emoji_photo(self._icon, isz)
            if foto:
                self.create_image(x, cy, anchor="w", image=foto)
            else:
                self.create_text(x, cy, anchor="w", text=self._icon, fill=color, font=("Segoe UI Emoji", 11))
        self.create_text(x + iw + gap, cy, anchor="w", text=self._text, fill=color, font=self._font)

    # ---- eventos ----

    def _set_over(self, v):
        self._over = v
        self._target = 1.0 if v else 0.0
        self._animar_hover()

    def _animar_hover(self):
        if not self.winfo_exists():
            return
        if self._anim_job:
            try:
                self.after_cancel(self._anim_job)
            except Exception:
                pass
            self._anim_job = None
        paso = 0.34
        if self._t < self._target:
            self._t = min(self._target, self._t + paso)
        elif self._t > self._target:
            self._t = max(self._target, self._t - paso)
        self._render()
        if self._t != self._target:
            self._anim_job = self.after(16, self._animar_hover)

    def _on_press(self, e):
        if self._state != "disabled":
            self._down = True
            self._render()

    def _on_release(self, e):
        was = self._down
        self._down = False
        self._render()
        if was and self._command and 0 <= e.x <= self.winfo_width() and 0 <= e.y <= self._h:
            self._command()

    # ---- API compatible con tk.Button ----
    def config(self, **kw):
        if threading.current_thread() is not threading.main_thread():
            self.after(0, lambda: self.config(**kw))
            return
        if "state" in kw:
            self._state = str(kw.pop("state"))
            tk.Canvas.configure(self, cursor="arrow" if self._state == "disabled" else "hand2")
        if "command" in kw:
            self._command = kw.pop("command")
        if "bg" in kw:
            self._danger = str(kw.pop("bg")).upper() == "#DC3545"
        if "fg" in kw:
            self._fg = kw.pop("fg")
        if "outline" in kw:
            self._border = kw.pop("outline")
        if "text" in kw or "icon" in kw:
            self._set_text(kw.pop("text", self._text), kw.pop("icon", None))
            self._fit_width()
        if kw:
            tk.Canvas.configure(self, **kw)
        self._render()
    configure = config


class PillLabel(tk.Canvas):
    """Etiqueta pequeña redondeada (ej. 'v0.1 Beta')."""
    def __init__(self, parent, text, fill, fg, font=(FONT, 9), padx=12, height=26):
        f = tkfont.Font(family=font[0], size=font[1])
        w = f.measure(text) + 2 * padx
        super().__init__(parent, width=w, height=height, bg=parent.cget("bg"), highlightthickness=0, bd=0)
        self._img = ImageTk.PhotoImage(make_round_image(w, height, height // 2, fill, parent.cget("bg")))
        self.create_image(0, 0, anchor="nw", image=self._img)
        self.create_text(w / 2, height / 2, text=text, fill=fg, font=font)


class StatusLabel(tk.Label):
    """Texto de la barra inferior. El color 'fg' que usa el programa cambia el color de la barra."""
    COLORES = {"#28A745": UI_GREEN, "#DC3545": "#C94545", "#0D6EFD": "#2F6FB5",
               "#FF8C00": "#DB8A1F", "#333333": "#5C6B79"}

    def __init__(self, parent, bar):
        super().__init__(parent, bg=bar.cget("bg"), fg="#FFFFFF", font=(FONT + " Semibold", 12), anchor="w")
        self._bar, self._pills = bar, []

    def attach(self, widget):
        self._pills.append(widget)

    def config(self, **kw):
        if threading.current_thread() is not threading.main_thread():
            self.after(0, lambda: self.config(**kw))
            return
        fg = kw.pop("fg", None)
        if fg is not None:
            color = self.COLORES.get(str(fg).upper())
            if color:
                self._bar.configure(bg=color)
                tk.Label.configure(self, bg=color)
                for p in self._pills:
                    p.refresh()
        if kw:
            tk.Label.configure(self, **kw)
    configure = config


class NoteLabel(tk.Frame):
    """Nota con foquito debajo de los botones. Reemplaza al antiguo label de estado del archivo."""
    def __init__(self, parent, bg):
        super().__init__(parent, bg=bg)
        foto = emoji_photo("💡", 16)
        if foto:
            self._ico = tk.Label(self, image=foto, bg=bg, bd=0)
            self._ico.image = foto
        else:
            self._ico = tk.Label(self, text="💡", bg=bg, font=("Segoe UI Emoji", 10), bd=0)
        self._ico.pack(side=tk.LEFT, anchor="n", padx=(2, 6), pady=(1, 0))
        self._lbl = tk.Label(self, text="", font=(FONT, 9), fg=UI_TEXT, bg=bg, justify="left", anchor="w")
        self._lbl.pack(side=tk.LEFT, fill=tk.X, expand=True)
        self.bind("<Configure>", lambda e: self._lbl.configure(wraplength=max(80, e.width - 34)))

    def config(self, **kw):
        if threading.current_thread() is not threading.main_thread():
            self.after(0, lambda: self.config(**kw))
            return
        texto = kw.pop("text", None)
        if texto is not None:
            texto = EMOJI_STRIP_RE.sub("", texto).strip()
            self._lbl.configure(text=("Nota: " + texto) if texto else "")
        kw.pop("fg", None)
        if kw:
            tk.Frame.configure(self, **kw)
    configure = config


class HistoryList(tk.Frame):
    """Lista de tandas con tarjetitas separadas por líneas.
    Clic derecho: abrir / renombrar / eliminar. Tecla Supr: eliminar. Enter: abrir."""
    def __init__(self, parent, bg, on_open, on_delete=None, on_rename=None):
        super().__init__(parent, bg=bg)
        self._bg, self._on_open = bg, on_open
        self._on_delete, self._on_rename = on_delete, on_rename
        self._rows, self._sel = [], None
        self.columnconfigure(0, weight=1)
        self.rowconfigure(0, weight=1)
        self.cv = tk.Canvas(self, bg=bg, highlightthickness=0, bd=0)
        self.sb = ttk.Scrollbar(self, orient=tk.VERTICAL, command=self.cv.yview, style="Thin.Vertical.TScrollbar")
        self.cv.configure(yscrollcommand=self._on_scroll)
        self.cv.grid(row=0, column=0, sticky="nsew")
        self.body = tk.Frame(self.cv, bg=bg)
        self._win = self.cv.create_window((0, 0), window=self.body, anchor="nw")
        self.body.bind("<Configure>", lambda e: self.cv.configure(scrollregion=self.cv.bbox("all")))
        self.cv.bind("<Configure>", lambda e: self.cv.itemconfigure(self._win, width=e.width))
        self.bind_all("<MouseWheel>", self._wheel, add="+")

        self.menu = tk.Menu(self, tearoff=0)
        self.menu.add_command(label="Abrir detalle", command=lambda: self._llamar(self._on_open))
        self.menu.add_command(label="Renombrar", command=lambda: self._llamar(self._on_rename))
        self.menu.add_separator()
        self.menu.add_command(label="Eliminar", command=lambda: self._llamar(self._on_delete))
        self.cv.bind("<Delete>", lambda e: self._llamar(self._on_delete))
        self.cv.bind("<Return>", lambda e: self._llamar(self._on_open))

    def _llamar(self, fn):
        if fn is not None and self._sel is not None:
            fn(self._sel)

    def _on_scroll(self, lo, hi):
        self.sb.set(lo, hi)
        if float(lo) <= 0.0 and float(hi) >= 1.0:
            self.sb.grid_remove()
        else:
            self.sb.grid(row=0, column=1, sticky="ns")

    def _wheel(self, e):
        w = self.winfo_containing(e.x_root, e.y_root)
        if w is not None and str(w).startswith(str(self)) and self.sb.winfo_ismapped():
            self.cv.yview_scroll(int(-e.delta / 120), "units")

    def _click(self, i):
        self._select(i)
        self.cv.focus_set()

    def _popup(self, e, i):
        self._click(i)
        try:
            self.menu.tk_popup(e.x_root, e.y_root)
        finally:
            self.menu.grab_release()


    def populate(self, tandas, vacio="Aún no hay tandas guardadas"):
        for w in self.body.winfo_children():
            w.destroy()
        self._rows, self._sel = [], None
        if not tandas:
            tk.Label(self.body, text=vacio, font=(FONT, 9), fg=UI_MUTED,
                     bg=self._bg).pack(anchor="w", padx=10, pady=10)
            return
        for i, t in enumerate(tandas):
            row = tk.Frame(self.body, bg=self._bg)
            row.pack(fill=tk.X)
            inner = tk.Frame(row, bg=self._bg)
            inner.pack(fill=tk.X, padx=10, pady=9)
            l1 = tk.Label(inner, text=str(t.get("id", f"TANDA-{i + 1}"))[:24], font=(FONT, 10, "bold"),
                          fg=UI_TEXT, bg=self._bg, anchor="w")
            l2 = tk.Label(inner, text=f"({formatear_fecha_corta(t.get('fecha', 'N/A'))})", font=(FONT, 10),
                          fg=UI_TEXT, bg=self._bg, anchor="w")
            l3 = tk.Label(inner, text=f"{t.get('total_crudo', 0)} crudos / {t.get('total_consolidado', 0)} consolidados",
                          font=(FONT, 9), fg=UI_TEXT, bg=self._bg, anchor="w")
            for lbl in (l1, l2, l3):
                lbl.pack(fill=tk.X)
            razon = str(t.get("razon", "")).upper()
            badge = None
            if razon:
                bgc, fgc = RAZON_COLORES.get(razon, ("#E9ECEF", "#495057"))
                badge = tk.Label(inner, text=f"  {razon}  ", font=(FONT, 8, "bold"), bg=bgc, fg=fgc)
                badge.pack(anchor="w", pady=(5, 0))
            tk.Frame(self.body, bg=UI_LINE, height=1).pack(fill=tk.X)
            widgets = [row, inner, l1, l2, l3]
            self._rows.append(widgets)
            for w in widgets + ([badge] if badge else []):
                w.bind("<Button-1>", lambda e, i=i: self._click(i))
                w.bind("<Button-3>", lambda e, i=i: self._popup(e, i))
                w.bind("<Double-1>", lambda e, i=i: self._on_open(i))
        self._select(0)

    def _select(self, i):
        if self._sel is not None and self._sel < len(self._rows):
            for w in self._rows[self._sel]:
                w.configure(bg=self._bg)
        self._sel = i
        for w in self._rows[i]:
            w.configure(bg=UI_SEL)


# =====================================================================
#  HELPERS DE MODALES MODERNOS
# =====================================================================
def fade_in(win, pasos=8, ms=16):
    """Aparición suave de una ventana."""
    try:
        win.attributes("-alpha", 0.0)
    except tk.TclError:
        return

    def paso(i=0):
        try:
            win.attributes("-alpha", min(1.0, i / pasos))
        except tk.TclError:
            return
        if i < pasos:
            win.after(ms, lambda: paso(i + 1))
    paso()


def crear_modal(parent, titulo, ancho, alto, resizable=False, minsize=None):
    m = tk.Toplevel(parent)
    m.title(titulo)
    m.configure(bg=UI_BG)
    m.resizable(resizable, resizable)
    if minsize:
        m.minsize(*minsize)
    m.transient(parent)
    try:
        parent.update_idletasks()
        x = parent.winfo_rootx() + (parent.winfo_width() - ancho) // 2
        y = parent.winfo_rooty() + (parent.winfo_height() - alto) // 3
        m.geometry(f"{ancho}x{alto}+{max(x, 0)}+{max(y, 0)}")
    except Exception:
        m.geometry(f"{ancho}x{alto}")
    try:
        m.grab_set()
    except tk.TclError:
        pass
    fade_in(m)
    return m


def entry_pill(parent, textvariable=None, font=(FONT, 11)):
    caja = tk.Frame(parent, bg="#FFFFFF", highlightthickness=1,
                    highlightbackground="#C9CED3", highlightcolor="#2F6FB5")
    e = tk.Entry(caja, textvariable=textvariable, relief="flat", bd=0, bg="#FFFFFF", fg=UI_TEXT,
                 insertbackground=UI_TEXT, font=font)
    e.pack(fill=tk.X, padx=10, ipady=7)
    habilitar_atajos_portapapeles(e)
    return caja, e


def campo_modal(parent, etiqueta, valor="", ayuda=None):
    bg = parent.cget("bg")
    tk.Label(parent, text=etiqueta, font=(FONT, 10, "bold"), fg=UI_TEXT, bg=bg,
             wraplength=430, justify="left").pack(anchor="w", pady=(10, 4))
    var = tk.StringVar(value=valor)
    caja, ent = entry_pill(parent, var)
    caja.pack(fill=tk.X)
    if ayuda:
        tk.Label(parent, text=ayuda, font=(FONT, 8), fg=UI_MUTED, bg=bg,
                 wraplength=430, justify="left").pack(anchor="w", pady=(3, 0))
    return var, ent


ESTILOS_BTN = {
    "normal": {},
    "primario": dict(fill=UI_GREEN, border=UI_GREEN, fg="#FFFFFF", hover="#35AE5E", shadow=0.2),
    "peligro": dict(fill="#FFF7F7", border="#D9534F", fg="#8E1B1B", hover="#FDEBEB"),
    "violeta": dict(fill="#F4F0FC", border="#B9A3E3", fg="#4B2E83", hover="#E9E0F8"),
    "naranja": dict(fill="#FFF4E8", border="#F0A560", fg="#9A4F00", hover="#FFE9D2"),
}


def fila_botones(parent, botones, height=44):
    fila = tk.Frame(parent, bg=parent.cget("bg"))
    for texto, cmd, estilo in botones:
        PillButton(fila, text=texto, command=cmd, height=height, **ESTILOS_BTN[estilo]).pack(
            side=tk.LEFT, expand=True, fill=tk.X, padx=3)
    return fila


class AvisoFinal(tk.Toplevel):
    """Ventanita de aviso con icono animado (check verde o alerta naranja)."""
    def __init__(self, parent, titulo, lineas, tipo="ok", boton="Entendido"):
        super().__init__(parent)
        self.title(titulo)
        self.configure(bg=UI_BG)
        self.resizable(False, False)
        self.attributes("-topmost", True)
        self._tipo = tipo
        self._color = UI_GREEN if tipo == "ok" else "#DB8A1F"
        W, H = 420, 400
        x = (self.winfo_screenwidth() - W) // 2
        y = (self.winfo_screenheight() - H) // 3
        self.geometry(f"{W}x{H}+{x}+{y}")

        card = Card(self, UI_BG, UI_CARD)
        card.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)
        c = card.inner

        if tipo == "ok":
            estilo = ESTILOS_BTN["primario"]
        else:
            estilo = dict(fill="#DB8A1F", border="#DB8A1F", fg="#FFFFFF", hover="#E89A33", shadow=0.2)
        PillButton(c, text=boton, command=self.destroy, height=46, **estilo).pack(
            side=tk.BOTTOM, fill=tk.X, padx=16, pady=(8, 6))

        self.cv = tk.Canvas(c, width=96, height=96, bg=UI_CARD, highlightthickness=0, bd=0)
        self.cv.pack(pady=(10, 6))
        tk.Label(c, text=titulo, font=(FONT + " Semibold", 16), fg=UI_TEXT, bg=UI_CARD,
                 wraplength=340, justify="center").pack()
        for l in lineas:
            tk.Label(c, text=l, font=(FONT, 10), fg=UI_MUTED, bg=UI_CARD,
                     wraplength=340, justify="center").pack(pady=1)

        self.bind("<Return>", lambda e: self.destroy())
        self.bind("<Escape>", lambda e: self.destroy())
        try:
            import winsound
            winsound.MessageBeep(winsound.MB_ICONASTERISK)
        except Exception:
            pass
        fade_in(self)
        self.lift()
        self.focus_force()
        self._anim(0)

    def _anim(self, f=0):
        if not self.winfo_exists():
            return
        c = self.cv
        c.delete("all")
        c.create_oval(8, 8, 88, 88, outline="#DDE5EA", width=6)
        c.create_arc(8, 8, 88, 88, start=90, extent=-359.9 * min(f / 18.0, 1.0),
                     style="arc", outline=self._color, width=6)
        if f > 18:
            t = min((f - 18) / 10.0, 1.0)
            if self._tipo == "ok":
                p1, p2, p3 = (29, 50), (43, 64), (68, 34)
                if t <= 0.5:
                    k = t / 0.5
                    pts = [p1, (p1[0] + (p2[0] - p1[0]) * k, p1[1] + (p2[1] - p1[1]) * k)]
                else:
                    k = (t - 0.5) / 0.5
                    pts = [p1, p2, (p2[0] + (p3[0] - p2[0]) * k, p2[1] + (p3[1] - p2[1]) * k)]
                c.create_line(*[v for p in pts for v in p], fill=self._color, width=6,
                              capstyle="round", joinstyle="round")
            else:
                c.create_line(48, 26, 48, 54, fill=self._color, width=6, capstyle="round")
                c.create_oval(45, 63, 51, 69, fill=self._color, outline=self._color)
        if f < 30:
            self.after(18, lambda: self._anim(f + 1))


class AppCargaInventario:
    def __init__(self, root):
        self.root = root
        self.root.title("Asistente integral de Inventario - Galerias Hipermarket v0.1 (Beta)")
        self.root.geometry("1320x580")
        self.root.minsize(1100, 520)
        
        if os.path.exists("icono.ico"):
            try:
                self.root.iconbitmap("icono.ico")
            except:
                pass
                
        self.api_key = self.cargar_api_key()
        self.catalogo = cargar_catalogo_completo()
        self.historial_tandas = cargar_historial_tandas()
        self.historial_visible = []
        
        self.df_raw = None
        self.df_consolidado = None
        self.local_ip = get_local_ip()
        self.ejecutando_carga = False
        self.ejecutando_ocr = False
        self.tanda_actual_id = None

        self._progreso = None          # avance de la carga en Java (para retomarla)
        self._modal_agregar = None     # permite añadir líneas al editor manual si está abierto
        self._modal_manual = None
        try:
            respaldar_datos()
        except Exception:
            pass
        
        self._ocr_jobs = []
        self._ocr_lock = threading.Lock()
        self._fotos_hash = {}                    # huellas de fotos recientes (anti doble envío)
        self._ocr_sem = threading.Semaphore(2)   # máximo 2 fotos consultando a Gemini a la vez
        self._modo_rapido = False
        self.crear_interfaz()
        self.actualizar_estado_key_btn()
        self._actualizar_boton_manual()
        self._iniciar_preferencias()
        
        if HAS_SERVER_LIBS:
            self.iniciar_servidor_local()
        fade_in(self.root)
        threading.Thread(target=lambda: pd.DataFrame, daemon=True).start()   # precarga pandas sin frenar la ventana

    def cargar_api_key(self):
        config_path = get_config_path()
        if os.path.exists(config_path):
            try:
                with open(config_path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    return data.get("api_key", "")
            except:
                return ""
        return ""

    def guardar_api_key(self, key):
        config_path = get_config_path()
        try:
            with open(config_path, "w", encoding="utf-8") as f:
                json.dump({"api_key": key}, f)
            self.api_key = key
            self.actualizar_estado_key_btn()
        except Exception as e:
            messagebox.showerror("Error", f"No se pudo guardar la clave:\n{e}")

    def actualizar_estado_key_btn(self):
        if self.api_key:
            self.btn_key.config(text="🔑 API Key", outline="#FFFFFF")
        else:
            self.btn_key.config(text="🔑 Configurar API Key", outline="#FF8A65")

    def solicitar_api_key_gui(self):
        key = simpledialog.askstring("Configurar Gemini API Key", 
                                     "Ingrese su API Key de Google Gemini:\n(Se guardará permanentemente)", 
                                     initialvalue=self.api_key)
        if key is not None and key.strip() != "":
            self.guardar_api_key(key.strip())
            messagebox.showinfo("Éxito", "¡API Key guardada correctamente!")


    def abrir_modal_nuevo_insumo(self):
        modal = crear_modal(self.root, "Añadir nuevo insumo", 460, 400)
        card = Card(modal, UI_BG, UI_CARD)
        card.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)
        c = card.inner
        tk.Label(c, text="Registrar nuevo insumo", font=(FONT + " Semibold", 14), fg=UI_TEXT, bg=UI_CARD).pack(anchor="w", pady=(4, 0))
        tk.Label(c, text="Se guarda en tu catálogo y se aplica a la lista actual.", font=(FONT, 9), fg=UI_MUTED, bg=UI_CARD).pack(anchor="w")
        var_nom, ent_nombre = campo_modal(c, "Nombre del insumo / alias (ej: MORA)")
        var_cod, ent_codigo = campo_modal(c, "Código del sistema Java (ej: 047886)")

        def guardar(*_):
            nom, cod = var_nom.get().strip(), var_cod.get().strip()
            if not nom or not cod:
                messagebox.showwarning("Campos vacíos", "Debes ingresar tanto el Nombre como el Código del insumo.", parent=modal)
                return
            guardar_insumo_personalizado(nom, cod)
            self.catalogo = cargar_catalogo_completo()
            if self.df_raw is not None and not self.df_raw.empty:
                self.procesar_df_crudo()
            messagebox.showinfo("Éxito", f"¡Insumo registrado!\n\n• {nom.upper()} ➔ Código: {cod}", parent=modal)
            modal.destroy()

        fila_botones(c, [("Cancelar", modal.destroy, "normal"),
                         ("💾 Guardar insumo", guardar, "primario")]).pack(fill=tk.X, side=tk.BOTTOM, pady=(14, 4))
        modal.bind("<Return>", guardar)
        modal.bind("<Escape>", lambda e: modal.destroy())
        ent_nombre.focus_set()

    def _crear_logo(self, parent):
        """Usa 'logo.png' (junto al script) si existe; si no, dibuja un logo de respaldo."""
        ruta = os.path.join(os.path.dirname(os.path.abspath(__file__)), "logo.png")
        if os.path.exists(ruta):
            try:
                img = Image.open(ruta).convert("RGBA")
                h = 46
                img = img.resize((int(img.width * h / img.height), h), Image.LANCZOS)
                self._logo_img = ImageTk.PhotoImage(img)
                tk.Label(parent, image=self._logo_img, bg=UI_NAVY, bd=0).pack(side=tk.LEFT, padx=(17, 8))
                return
            except Exception:
                pass
        c = tk.Canvas(parent, width=172, height=48, bg=UI_NAVY, highlightthickness=0, bd=0)
        c.create_oval(4, 4, 44, 44, outline="#FFFFFF", width=4)
        c.create_arc(4, 4, 44, 44, start=-35, extent=110, style="arc", outline=UI_ORANGE, width=4)
        c.create_text(24, 24, text="G", fill="#FFFFFF", font=(FONT, 17, "bold"))
        c.create_text(54, 18, text="GALERÍAS", anchor="w", fill="#FFFFFF", font=(FONT, 15, "bold"))
        c.create_text(55, 36, text="HIPERMARKET", anchor="w", fill="#FF7A4D", font=(FONT, 8, "bold"))
        c.pack(side=tk.LEFT, padx=(17, 8))

    def _titulo_seccion(self, parent, texto, icono=None):
        fila = tk.Frame(parent, bg=UI_CARD)
        fila.pack(fill=tk.X, pady=(4, 12))
        if icono:
            foto = emoji_photo(icono, 22)
            if foto:
                lbl = tk.Label(fila, image=foto, bg=UI_CARD, bd=0)
                lbl.image = foto
                lbl.pack(side=tk.LEFT, padx=(0, 8))
        tk.Label(fila, text=texto, font=(FONT + " Semibold", 13), fg=UI_TEXT, bg=UI_CARD).pack(side=tk.LEFT)
        return fila

    def crear_interfaz(self):
        # ---------- Estilos ttk ----------
        s = ttk.Style(self.root)
        try:
            s.theme_use("clam")
        except tk.TclError:
            pass
        s.configure("Work.Treeview", background=UI_CARD, fieldbackground=UI_CARD, foreground=UI_TEXT,
                    rowheight=38, borderwidth=0, relief="flat", font=(FONT, 10))
        s.configure("Work.Treeview.Heading", background=UI_CARD, foreground=UI_TEXT, relief="flat",
                    borderwidth=0, font=(FONT, 10), padding=(8, 8))
        s.map("Work.Treeview.Heading", background=[("active", UI_CARD)], relief=[("active", "flat")])
        s.map("Work.Treeview", background=[("selected", UI_SEL)], foreground=[("selected", UI_TEXT)])
        s.layout("Work.Treeview", [("Treeview.treearea", {"sticky": "nswe"})])
        s.layout("Thin.Vertical.TScrollbar", [("Vertical.Scrollbar.trough", {
            "sticky": "ns", "children": [("Vertical.Scrollbar.thumb", {"expand": "1", "sticky": "nswe"})]})])
        s.configure("Thin.Vertical.TScrollbar", troughcolor=UI_CARD, background="#C3C9CF", bordercolor=UI_CARD,
                    lightcolor="#C3C9CF", darkcolor="#C3C9CF", gripcount=0, width=8, relief="flat")
        s.map("Thin.Vertical.TScrollbar", background=[("active", "#A9B1B8")])
        # Barra de scroll horizontal (mismo estilo delgado)
        s.layout("Thin.Horizontal.TScrollbar", [("Horizontal.Scrollbar.trough", {
            "sticky": "ew", "children": [("Horizontal.Scrollbar.thumb", {"expand": "1", "sticky": "nswe"})]})])
        s.configure("Thin.Horizontal.TScrollbar", troughcolor=UI_CARD, background="#C3C9CF", bordercolor=UI_CARD,
                    lightcolor="#C3C9CF", darkcolor="#C3C9CF", gripcount=0, width=10, relief="flat")
        s.map("Thin.Horizontal.TScrollbar", background=[("active", "#A9B1B8")])

        # Tablas compactas para modales
        s.configure("Mini.Treeview", background=UI_CARD, fieldbackground=UI_CARD, foreground=UI_TEXT,
                    rowheight=28, borderwidth=0, relief="flat", font=(FONT, 10))
        s.configure("Mini.Treeview.Heading", background="#E3E8EC", foreground=UI_TEXT, relief="flat",
                    borderwidth=0, font=(FONT, 10, "bold"), padding=(8, 6))
        s.map("Mini.Treeview.Heading", background=[("active", "#E3E8EC")])
        s.map("Mini.Treeview", background=[("selected", UI_SEL)], foreground=[("selected", UI_TEXT)])
        s.layout("Mini.Treeview", [("Treeview.treearea", {"sticky": "nswe"})])
        # Pestañas modernas
        s.configure("TNotebook", background=UI_BG, borderwidth=0, tabmargins=(0, 0, 0, 0))
        s.configure("TNotebook.Tab", padding=(18, 8), font=(FONT, 10), background="#D5DCE2",
                    foreground=UI_TEXT, borderwidth=0)
        s.map("TNotebook.Tab", background=[("selected", UI_CARD)], font=[("selected", (FONT, 10, "bold"))])
        # Dropdown de razón
        s.configure("Pill.TCombobox", fieldbackground="#FFFFFF", background="#FFFFFF", foreground=UI_TEXT,
                    arrowcolor=UI_MUTED, bordercolor="#C9CED3", lightcolor="#FFFFFF", darkcolor="#FFFFFF",
                    padding=(10, 6), arrowsize=14)
        s.map("Pill.TCombobox", fieldbackground=[("readonly", "#FFFFFF")],
              foreground=[("readonly", UI_TEXT), ("focus", UI_TEXT)],
              selectbackground=[("readonly", "#FFFFFF"), ("focus", "#FFFFFF")],
              selectforeground=[("readonly", UI_TEXT), ("focus", UI_TEXT)],
              bordercolor=[("focus", "#2F6FB5")])
        self.root.option_add("*TCombobox*Listbox.font", (FONT, 10))
        self.root.option_add("*TCombobox*Listbox.selectBackground", "#2F6FB5")

        self.root.configure(bg=UI_BG)
        self.root.columnconfigure(0, weight=1)
        self.root.rowconfigure(1, weight=1)

        # ---------- Cabecera ----------
        header = tk.Frame(self.root, bg=UI_NAVY, height=70)
        header.grid(row=0, column=0, sticky="ew")
        header.pack_propagate(False)

        self._crear_logo(header)
        PillLabel(header, "v0.1 Beta", fill="#2F4F6B", fg="#C9D6E2").pack(side=tk.LEFT)

        self.btn_key = PillButton(header, text="🔑 API Key", command=self.solicitar_api_key_gui, height=46,
                                  fill=UI_NAVY, border="#FFFFFF", fg="#FFFFFF", hover="#1B4A6B", padx=18)
        self.btn_key.pack(side=tk.RIGHT, padx=(6, 13))

        btn_add_insumo = PillButton(header, text="+ Añadir Insumo", command=self.abrir_modal_nuevo_insumo,
                                    height=46, fill=UI_ORANGE, border=UI_ORANGE, fg="#FFFFFF",
                                    hover="#FF6E45", shadow=0.25, padx=18)
        btn_add_insumo.pack(side=tk.RIGHT)

        # ---------- Cuerpo: 3 tarjetas ----------
